<section class="section">
  <div class="wrap" style="text-align:center">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
    </div>

    {%- if section.settings.body != blank -%}
      <p class="lead">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="hero-actions" style="justify-content:center">
      <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label kecil", "default": "404" },
    { "type": "text", "id": "heading", "label": "Tajuk", "default": "Halaman tidak dijumpai." },
    { "type": "textarea", "id": "body", "label": "Teks", "default": "Pautan yang anda ikuti mungkin sudah dipadam atau dialihkan. Semak sekali lagi, atau kembali ke laman utama." },
    { "type": "text", "id": "cta_label", "label": "Label butang", "default": "Kembali ke Utama" }
  ],
  "presets": [{ "name": "404" }]
}
{% endschema %}

<section class="section cta-final">
  <div class="wrap">
    <div class="cta-final-inner" data-reveal>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA akhir",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tajuk", "default": "Sedia untuk lebih selesa?" },
    { "type": "textarea", "id": "body", "label": "Teks", "default": "Order hari ini. Impression kit sampai dalam 2–3 hari kerja." },
    { "type": "text", "id": "cta_label", "label": "Label butang", "default": "Order Sekarang" },
    { "type": "url", "id": "cta_url", "label": "Pautan butang" }
  ],
  "presets": [{ "name": "CTA akhir" }]
}
{% endschema %}

<section class="section">
  <div class="wrap" style="text-align:center">

    <div class="brand" style="justify-content:center;margin-bottom:var(--s-3)">
      {% render 'logo' %}
    </div>

    <div class="section-head">
      <span class="eyebrow">{{ shop.name }}</span>
      <h1>{{ shop.password_message | default: 'general.password_page.opening_soon' | t }}</h1>
    </div>

    <p class="lead">{{ section.settings.body }}</p>

    <form action="{{ routes.password_url }}" method="post" style="max-width:420px;margin:0 auto;text-align:left">
      <input type="hidden" name="form_type" value="storefront_password">
      <input type="hidden" name="utf8" value="&#10003;">

      <div class="form-row">
        <label class="form-label" for="password-input">{{ 'general.password_page.label' | t }}</label>
        <input class="form-input"
               id="password-input"
               type="password"
               name="password"
               placeholder="{{ 'general.password_page.placeholder' | t }}"
               autocomplete="current-password"
               required>
      </div>

      <button type="submit" class="btn btn--primary btn--lg btn--block">{{ section.settings.cta_label }}</button>
    </form>

    {%- if shop.password_message == blank -%}
      <p class="lead" style="margin-top:var(--s-3)">{{ 'general.password_page.thanks' | t }}</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "body", "label": "Teks", "default": "Masukkan kata laluan untuk melihat laman ini." },
    { "type": "text", "id": "cta_label", "label": "Label butang", "default": "Masuk" }
  ],
  "presets": [{ "name": "Password" }]
}
{% endschema %}

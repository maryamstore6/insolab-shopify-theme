<section class="section section--tight">
  <div class="wrap split {% if section.settings.flip %}split--flip{% endif %}">
    <div class="split-visual split-visual--video">
      {%- if section.settings.video != blank -%}
        {%- comment -%}
          video_tag accepts the same HTML attributes; poster and aria-label are
          passed so the frame is not black before load and screen readers get a
          description. `controls: false` keeps it a background film.
        {%- endcomment -%}
        {%- if section.settings.poster != blank -%}
          {{ section.settings.video | video_tag:
               autoplay: true, loop: true, muted: true, playsinline: true,
               controls: false, preload: 'metadata',
               class: 'split-visual-film',
               poster: section.settings.poster,
               aria-label: section.settings.video_alt }}
        {%- else -%}
          {{ section.settings.video | video_tag:
               autoplay: true, loop: true, muted: true, playsinline: true,
               controls: false, preload: 'metadata',
               class: 'split-visual-film',
               aria-label: section.settings.video_alt }}
        {%- endif -%}
      {%- elsif section.settings.video_url != blank -%}
        <video class="split-visual-film"
               {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% else %}poster="{{ 'imprint-guide-poster.jpg' | asset_url }}"{% endif %}
               preload="metadata" muted loop playsinline autoplay
               aria-label="{{ section.settings.video_alt | escape }}">
          <source src="{{ section.settings.video_url }}" type="video/mp4">
          {%- comment -%}
            An external URL can only be one file, so this branch cannot offer a
            webm alternative the way the bundled branch does. Use MP4 (H.264)
            here for the widest support, or upload to Shopify Content -> Files
            and use the "Video Shopify" field instead.
          {%- endcomment -%}
        </video>
      {%- elsif section.settings.bundled_video == 'guide' or section.settings.bundled_video == 'adult' -%}
        {%- if section.settings.bundled_video == 'guide' -%}
          {%- assign bundled_webm = 'imprint-guide.webm' -%}
          {%- assign bundled_mp4 = 'imprint-guide.mp4' -%}
          {%- assign bundled_poster = 'imprint-guide-poster.jpg' -%}
        {%- else -%}
          {%- assign bundled_webm = 'imprint-adult.webm' -%}
          {%- assign bundled_mp4 = 'imprint-adult.mp4' -%}
          {%- assign bundled_poster = 'imprint-adult-poster.jpg' -%}
        {%- endif -%}
        <video class="split-visual-film"
               poster="{{ bundled_poster | asset_url }}"
               preload="metadata" muted loop playsinline autoplay
               aria-label="{{ section.settings.video_alt | escape }}">
          <source src="{{ bundled_webm | asset_url }}" type="video/webm">
          <source src="{{ bundled_mp4 | asset_url }}" type="video/mp4">
        </video>
      {%- else -%}
        {%- comment -%}
          Branch, don't chain the filters here: passing the merchant's
          uploaded poster through `default` and then into asset_url would
          hand an image object to a filename filter and emit a garbage
          path. Each source gets its own filter instead.
        {%- endcomment -%}
        {%- if section.settings.poster != blank -%}
          <img class="split-visual-film"
               src="{{ section.settings.poster | image_url: width: 1200 }}"
               width="{{ section.settings.poster.width }}"
               height="{{ section.settings.poster.height }}"
               alt="{{ section.settings.video_alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img class="split-visual-film"
               src="{{ 'imprint-guide-poster.jpg' | asset_url }}"
               width="1200" height="800"
               alt="{{ section.settings.video_alt | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="split-copy" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#faq' }}" class="btn btn--ghost">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split (video + teks)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label kecil", "default": "100% Dari Rumah" },
    { "type": "text", "id": "heading", "label": "Tajuk", "default": "Tiada temujanji. Tiada menunggu. Tiada ke mana-mana." },
    { "type": "textarea", "id": "body", "label": "Teks", "default": "Kami pos impression kit ke rumah anda. Tekan kaki ke foam tray ikut panduan bergambar — 5 minit sahaja. Hantar balik guna airway bill kami. Postage kami tanggung." },
    { "type": "text", "id": "cta_label", "label": "Label butang", "default": "Soalan Lazim" },
    { "type": "url", "id": "cta_url", "label": "Pautan butang" },
    { "type": "checkbox", "id": "flip", "label": "Balikkan susunan (teks kiri)", "default": false },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video Shopify (disyorkan)" },
    { "type": "url", "id": "video_url", "label": "Atau pautan fail video (mp4)" },
    { "type": "select", "id": "bundled_video", "label": "Video terbina dalam", "default": "guide", "options": [
      { "value": "none", "label": "Tiada (guna poster)" },
      { "value": "guide", "label": "Panduan imprint" },
      { "value": "adult", "label": "Imprint dewasa" }
    ] },
    { "type": "image_picker", "id": "poster", "label": "Poster / gambar ganti" },
    { "type": "text", "id": "video_alt", "label": "Alt teks", "default": "Teknik menekan kaki ke foam tray untuk mengambil bentuk kaki" }
  ],
  "presets": [{ "name": "Split (video + teks)" }]
}
{% endschema %}

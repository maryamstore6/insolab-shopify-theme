<section class="section" id="order-{{ section.id }}">
<span class="section-order-badge" aria-hidden="true">12</span>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="font-size:var(--t-lg);margin-top:var(--s-2)">{{ section.settings.heading }}</h2>
    </div>

    <div class="split split--buybox" style="align-items:start">
      <div class="buybox" data-reveal data-order-section="{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
        <div class="buybox-trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <span {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ block.settings.text }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        <ul class="buybox-benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="buybox-head">
          <div class="buybox-title">{{ section.settings.pick_title }}</div>
          <p class="buybox-sub">{{ section.settings.pick_sub }}</p>
        </div>

        <div class="pick-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'package' -%}
              <button type="button" class="pick{% if forloop.index == 1 %} is-picked{% endif %}"
                      data-package
                      data-name="{{ block.settings.name | escape }}"
                      data-units="{{ block.settings.units }}"
                      data-price="{{ block.settings.price | remove: 'RM' | remove: ',' | strip }}"
                      {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}<span class="pick-badge">{{ block.settings.badge }}</span>{%- endif -%}
                <span class="pick-top">
                  <span class="pick-name">{{ block.settings.name }}</span>
                  <span class="pick-price">
                    {%- if block.settings.compare_price != blank -%}<s>{{ block.settings.compare_price }}</s>{%- endif -%}
                    {{ block.settings.price }}
                  </span>
                </span>
                <span class="pick-meta">{{ block.settings.meta }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="qty-row">
          <span class="qty-label">{{ section.settings.qty_label }}</span>
          <div class="qty-stepper">
            <button type="button" data-qty-minus aria-label="Kurangkan kuantiti">&minus;</button>
            <span data-qty-value aria-live="polite">1</span>
            <button type="button" data-qty-plus aria-label="Tambah kuantiti">+</button>
          </div>
        </div>

        <a href="https://wa.me/60176055349" data-wa-cta class="btn btn--primary btn--lg btn--block buybox-cta" target="_blank" rel="noopener">
          {{ section.settings.cta_label }} — <span data-cta-total>RM599</span>
        </a>

        <div class="buybox-ship">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
          <span>{{ section.settings.ship_text }}</span>
        </div>

        <div class="summary-lines">
          <div class="summary-line"><span>{{ section.settings.sum_product }}</span><span data-sum-name>—</span></div>
          <div class="summary-line"><span>{{ section.settings.sum_qty }}</span><span data-sum-qty>—</span></div>
          <div class="summary-line"><span>{{ section.settings.sum_kit }}</span><span>{{ section.settings.sum_kit_value }}</span></div>
          <div class="summary-line"><span>{{ section.settings.sum_ship }}</span><span>{{ section.settings.sum_ship_value }}</span></div>
        </div>

        <div class="summary-total">
          <span>{{ section.settings.sum_total }}</span>
          <span data-sum-total>RM599</span>
        </div>

        <div class="buybox-urgency">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {{ section.settings.urgency }}
        </div>

        <div class="buybox-secure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
          {{ section.settings.secure }}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('order-{{ section.id }}');
  if (!section) return;
  var picks = section.querySelectorAll('[data-package]');
  var qtyEl = section.querySelector('[data-qty-value]');
  var minus = section.querySelector('[data-qty-minus]');
  var plus = section.querySelector('[data-qty-plus]');
  var cta = section.querySelector('[data-wa-cta]');
  var ctaTotal = section.querySelector('[data-cta-total]');
  var sumName = section.querySelector('[data-sum-name]');
  var sumQty = section.querySelector('[data-sum-qty]');
  var sumTotal = section.querySelector('[data-sum-total]');
  var qty = 1, selected = picks[0];

  function render() {
    if (!selected) return;
    var price = parseFloat(selected.getAttribute('data-price')) || 0;
    var units = parseInt(selected.getAttribute('data-units'), 10) || 1;
    var name = selected.getAttribute('data-name');
    var total = price * qty;
    var totalUnits = units * qty;
    if (sumName) sumName.textContent = name;
    if (sumQty) sumQty.textContent = qty > 1 ? qty + ' × ' + units + ' unit = ' + totalUnits + ' unit' : units + ' unit';
    if (sumTotal) sumTotal.textContent = 'RM' + total;
    if (ctaTotal) ctaTotal.textContent = 'RM' + total;
    if (qtyEl) qtyEl.textContent = qty;
    if (minus) minus.disabled = qty <= 1;
    if (plus) plus.disabled = qty >= 10;
    if (cta) {
      var msg = encodeURIComponent('Hai InsoLab, saya nak order: ' + name + ' (' + totalUnits + ' unit) — RM' + total);
      cta.href = 'https://wa.me/60176055349?text=' + msg;
    }
  }

  picks.forEach(function (p) {
    p.addEventListener('click', function () {
      picks.forEach(function (o) { o.classList.remove('is-picked'); });
      p.classList.add('is-picked');
      selected = p;
      qty = 1;
      render();
    });
  });
  if (minus) minus.addEventListener('click', function () { if (qty > 1) { qty--; render(); } });
  if (plus) plus.addEventListener('click', function () { if (qty < 10) { qty++; render(); } });
  render();
})();
</script>


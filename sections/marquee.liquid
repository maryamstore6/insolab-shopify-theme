{%- comment -%}
  MARQUEE — infinite scrolling band.

  The list is rendered twice so the CSS keyframe can translate the track by
  exactly -50% and loop seamlessly. Because the two halves are identical,
  one copy is hidden from assistive tech (aria-hidden, and the whole band is
  decorative) so a screen reader does not read every item twice.
{%- endcomment -%}
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="marquee-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "items",
      "label": "Teks marquee (asingkan dengan koma)",
      "default": "Impression Kit Percuma, Return Postage Ditanggung, Dibuat Khas Untuk Anda, 100 Hari Jaminan, Seluruh Malaysia",
      "info": "Dipaparkan sebagai senarai. Blok di bawah lebih diutama — kekalkan salah satu daripada dua cara ini."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Teks", "default": "Impression Kit Percuma" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "settings": {
        "items": "Impression Kit Percuma, Return Postage Ditanggung, Dibuat Khas Untuk Anda, 100 Hari Jaminan, Seluruh Malaysia"
      },
      "blocks": [
        { "type": "item", "settings": { "text": "Impression Kit Percuma" } },
        { "type": "item", "settings": { "text": "Return Postage Ditanggung" } },
        { "type": "item", "settings": { "text": "Dibuat Khas Untuk Anda" } },
        { "type": "item", "settings": { "text": "100 Hari Jaminan" } },
        { "type": "item", "settings": { "text": "Seluruh Malaysia" } }
      ]
    }
  ]
}
{% endschema %}

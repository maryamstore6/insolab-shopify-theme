<section class="section" id="page-{{ section.id }}">
  <div class="wrap">
    <div class="section-head">
      <h1>{{ page.title | default: section.settings.heading }}</h1>
    </div>
    <div class="page-content">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading fallback", "default": "Halaman" }
  ],
  "presets": [
    { "name": "Page" }
  ]
}
{% endschema %}

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="quote-grid" data-reveal-group>
      {%- for block in section.blocks -%}
        <figure class="quote-card" data-reveal style="margin:0" {{ block.shopify_attributes }}>
          <div class="quote-mark" aria-hidden="true">&ldquo;</div>
          <blockquote class="quote-text" style="margin:0">{{ block.settings.quote }}</blockquote>
          <figcaption class="quote-who">
            <div class="quote-avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</div>
            <div>
              <div class="quote-name">{{ block.settings.name }}</div>
              <div class="quote-role">{{ block.settings.product }}</div>
            </div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimoni",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label kecil", "default": "Pengalaman" },
    { "type": "text", "id": "heading", "label": "Tajuk", "default": "Apa kata mereka." }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimoni",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Petikan", "default": "Prosesnya senang. Buat imprint di rumah, hantar balik." },
        { "type": "text", "id": "name", "label": "Nama", "default": "Pelanggan" },
        { "type": "text", "id": "product", "label": "Produk", "default": "Custom Insole" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Testimoni", "blocks": [
    { "type": "quote", "settings": { "quote": "Kerja saya berdiri 8 jam sehari. Lepas pakai ni, kaki tak penat macam dulu.", "name": "Ahmad R.", "product": "On My Feet All Day" } },
    { "type": "quote", "settings": { "quote": "Prosesnya senang. Buat imprint di rumah, hantar balik. Tak perlu pergi mana-mana.", "name": "Siti N.", "product": "Normal Everyday Activity" } },
    { "type": "quote", "settings": { "quote": "Ambil 2 unit untuk saya dan suami. Harga berbaloi, selesa dipakai.", "name": "Lim W.", "product": "2 Unit Package" } }
  ]}]
}
{% endschema %}
